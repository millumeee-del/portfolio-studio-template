---
import '../styles/gallery-editor.css';
import {OVERVIEW_GALLERY} from '../lib/gallery-identity.js';
interface Props { category?: string; }
const { category=OVERVIEW_GALLERY } = Astro.props;
const label=category===OVERVIEW_GALLERY?'总览':'分区';
---
<section class="gallery-editor" data-gallery-editor data-category={category} aria-label={`${label}排版编辑器`}>
  <div class="gallery-editor-entry"><button type="button" data-layout-open>编辑排版</button></div>
  <div class="gallery-editor-panel" data-layout-panel hidden>
    <div class="gallery-editor-toolbar">
      <strong>编辑{label}排版</strong>
      <button type="button" data-layout-preview>预览</button>
      <button type="button" data-layout-undo disabled>撤销</button>
      <button type="button" data-layout-auto>恢复自动</button>
      <span class="gallery-editor-toolbar-spacer"></span>
      <button type="button" data-layout-cancel>取消修改</button>
      <button type="button" class="gallery-editor-save" data-layout-save>保存并退出</button>
    </div>
    <div class="gallery-editor-selected">
      <span data-layout-selected>点击卡片后，可输入精确尺寸</span>
      <label>宽度 <input type="number" min="96" step="1" data-layout-width disabled /> px</label>
      <label>高度 <input type="number" min="120" max="1200" step="1" data-layout-height disabled /> px</label>
      <button type="button" data-layout-next-row disabled>移到下一行</button>
      <button type="button" data-layout-previous-row disabled>移到上一行</button>
    </div>
    <p role="status" aria-live="polite" data-layout-status>把卡片拖入目标行的间隙或右侧空白处插入；拖边缘调尺寸。末张可自由缩窄，其他卡片过窄时换行。也可用“移到上一行 / 下一行”。</p>
  </div>
</section>
<script>
  import { mountGalleryEditors } from '../scripts/gallery-editor.js';
  mountGalleryEditors();
  document.addEventListener('astro:page-load', mountGalleryEditors);
</script>
